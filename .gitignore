# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
# vitest / jest snapshots
**/__snapshots__/
*.snap

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.local
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env.local

# editor / tool directories
.agents/
.kiro/
.vscode/

# storybook stories (generated/design artefacts, not shipped code)
**/*.stories.tsx
**/*.stories.ts

# misc project docs that don't belong in the repo root
issue.md
issues.md
