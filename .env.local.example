NEXT_PUBLIC_CONTRACT_ID=
# escrow-factory contract the create page calls; empty disables escrow creation.
NEXT_PUBLIC_FACTORY_CONTRACT_ID=
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_SOROBAN_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# Optional: platform arbiter offered as the default on the create form (G… or C… address).
NEXT_PUBLIC_DEFAULT_ARBITER=
# Optional: enable WalletConnect (mobile wallets). Get a project ID at https://cloud.reown.com/
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Optional: set to "true" to enable client-side error reporting to the backend.
NEXT_PUBLIC_CLIENT_ERROR_REPORTING=
